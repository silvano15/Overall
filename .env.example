# Configuração para PostgreSQL na nuvem (Supabase em São Paulo)
# URL para queries (Pooler modo Transaction, porta 6543)
DATABASE_URL="postgresql://postgres.iyjlxxusvmomhoqhogzb:[SENHA]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta para migrações / db push (Pooler modo Session, porta 5432)
DIRECT_URL="postgresql://postgres.iyjlxxusvmomhoqhogzb:[SENHA]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo JWT (obrigatório em produção, gere uma chave segura com no mínimo 32 caracteres)
JWT_SECRET="gere-um-segredo-jwt-forte-e-seguro-para-producao-123456"

# Tempo de expiração do token em horas (padrão 720 = 30 dias para uso mobile)
JWT_EXPIRATION_HOURS=720

# Fuso horário para registro das peladas e partidas
APP_TIMEZONE="America/Recife"

# Porta do servidor local (padrão 8080)
PORT=8080
